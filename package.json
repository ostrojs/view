{
    "name": "@ostro/view",
    "version": "2.0.0-alpha.1",
    "description": "View module for OstroJS",
    "scripts": {
        "build": "rm -rf build && npx tsc -p tsconfig.build.json && node scripts/build.js",
        "prepublishOnly": "npm run build",
        "test": "npx c8 npx jest",
        "clean": "rm -rf build coverage"
    },
    "main": "build/viewManager.js",
    "types": "build/viewManager.d.ts",
    "files": [
        "build"
    ],
    "exports": {
        ".": {
            "types": "./build/viewManager.d.ts",
            "default": "./build/viewManager.js"
        },
        "./*": {
            "types": "./build/*.d.ts",
            "default": "./build/*.js"
        }
    },
    "dependencies": {
        "@ostro/contracts": "^2.0.0-alpha.1",
        "@ostro/support": "^2.0.0-alpha.1",
        "bluebird": "^3.7.2",
        "lodash.get": "^4.4.2"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "keywords": [
        "nodejs view",
        "view"
    ],
    "author": "amar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/view.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/view/issues"
    },
    "homepage": "https://github.com/ostrojs/view#readme",
    "devDependencies": {
        "@types/node": "^22.20.5",
        "typescript": "^5.8.0"
    },
    "overrides": {
        "sprintf-js": "^1.1.3",
        "braces": "^3.0.3",
        "argparse": "^2.0.1",
        "js-yaml": "^4.1.0"
    }
}
